# --- Azure OpenAI (Planner) – identisch zu den anderen Portfolio-Projekten ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# Günstigeres Modell für Fülltext (Cost-Routing wie in ai-system-hub)
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o-mini

# --- Voiceover (ElevenLabs) ---
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- B-Roll (Pexels) ---
PEXELS_API_KEY=your_pexels_key

# --- Remotion: lokaler Render ---
# REMOTION_PROJECT_DIR=./remotion   # Default: das mitgelieferte remotion/-Projekt
REMOTION_COMPOSITION_ID=Reel

# --- Remotion: Lambda (Skalierung, optional) ---
# Erst nötig für hunderte parallele Cloud-Renders:
#   npx remotion lambda functions deploy
#   npx remotion lambda sites create
REMOTION_APP_REGION=us-east-1
REMOTION_APP_FUNCTION_NAME=
REMOTION_APP_SERVE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Auto-Posting (Skelett – erst mit echten Tokens aktiv) ---
# Ausschließlich offizielle Graph-APIs verwenden (sonst Account-Sperre).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# TIKTOK_ACCESS_TOKEN=
